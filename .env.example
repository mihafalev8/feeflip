# PumpPortal API Key (get one at https://pumpportal.fun/create-wallet)
PUMPPORTAL_API_KEY=your-api-key-here

# Token contract address on PumpFun
TOKEN_MINT=your-token-mint-address

# Solana RPC endpoint (recommended: Helius, QuickNode, Triton)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Fee pool type: "pump" or "meteora-dbc"
POOL_TYPE=pump

# Minutes between lottery drawings
DRAW_INTERVAL_MINUTES=30

# Minimum SOL in pool to trigger a drawing
MIN_JACKPOT_SOL=0.1

# Minimum token balance to qualify for lottery
MIN_HOLDER_TOKENS=1000

# SOL reserved for transaction fees (do not distribute)
SOL_RESERVE=0.05

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
